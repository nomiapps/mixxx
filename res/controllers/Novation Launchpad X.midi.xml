<?xml version='1.0' encoding='utf-8'?>
<!--
  Novation Launchpad X mapping for Mixxx.

  An instrument mapping: the 8x8 grid plays the built-in synth ([Synth1]) and
  edits the step sequencer ([Sequencer1]). See the script for the layout.

  The pad runs in Programmer mode, so the grid sends notes 11..88 (note =
  row * 10 + column, row 1 at the bottom), the top row sends CC 91..98 and the
  right-hand column CC 89, 79, ... 19 from the top down. Every grid pad goes to
  one handler and every button to another; the handlers read the index off the
  message rather than having a control per function.
-->
<MixxxControllerPreset mixxxVersion="2.6+" schemaVersion="1">
    <info>
        <name>Novation Launchpad X</name>
        <author>NomiApps</author>
        <description>Plays the Mixxx synth and step sequencer from the 8x8 grid, with velocity, scales and RGB feedback.</description>
    </info>
    <controller id="Launchpad X">
        <scriptfiles>
            <file functionprefix="LaunchpadX" filename="Novation-Launchpad-X-scripts.js"/>
        </scriptfiles>
